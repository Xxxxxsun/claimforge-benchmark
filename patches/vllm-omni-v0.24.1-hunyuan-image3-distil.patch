+def test_distilled_meanflow_step_uses_guidance_token_and_next_timestep(monkeypatch):
+    pipeline = _pipeline()
+    pipeline.hf_config = SimpleNamespace(cfg_distilled=True, use_meanflow=True)
+    monkeypatch.setattr(HunyuanImage3Pipeline, "device", property(lambda self: torch.device("cpu")))
+    state = _state("distilled", 1)
+    state.latents = torch.zeros(1, 1)
+    state.extra[_STEP_GUIDANCE_SCALE] = 2.5
+    state.extra[_STEP_PROMPT_KV] = [{"lens": torch.tensor([1])}]
+    captured = {}
+
+    pipeline._restore_prompt_kv_cache = lambda *args, **kwargs: None
+
+    def fake_prepare_inputs(input_ids, images, timestep, guidance, timestep_r, **model_kwargs):
+        captured.update(
+            input_ids=input_ids,
+            images=images.clone(),
+            timestep=timestep.clone(),
+            guidance=guidance.clone(),
+            timestep_r=timestep_r.clone(),
+        )
+        return {"model_kwargs": model_kwargs}
+
+    pipeline.prepare_inputs_for_generation = fake_prepare_inputs
+    pipeline.forward_call = lambda **kwargs: {"diffusion_prediction": torch.tensor([[3.0]])}
+    pipeline._update_model_kwargs_for_generation = lambda model_output, model_kwargs: model_kwargs
+
+    out = pipeline._denoise_step_group([state])
+
+    assert captured["input_ids"] is None
+    assert captured["timestep"].tolist() == [0.5]
+    assert captured["guidance"].item() == pytest.approx(2500.0, abs=8.0)
+    assert captured["timestep_r"].tolist() == [0.25]
+    torch.testing.assert_close(out, torch.tensor([[3.0]]))
+
+
 def test_later_step_merge_shifts_spans_without_polluting_request_state():
     pipeline = _pipeline()
     states = [_state("short", 2), _state("long", 4)]
